# =============================================================
# Hawkeyes Optical Prescription & Appointment System
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` to version control.
# =============================================================

APP_NAME=Hawkeyes Optical System
APP_ENV=development          # development | production
DEBUG=true

# --- Database (MySQL 8.x) -------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=hawkeye
DB_NAME=hawkeyes_db

# --- Security -------------------------------------------------
# Secret used for signing sessions/tokens (auth module comes later)
SECRET_KEY=change-me-to-a-long-random-string
# PBKDF2 password hashing iterations
SECURITY_ITERATIONS=390000

# --- Scheduler (APScheduler module comes later) ---------------
APPOINTMENT_REMINDER_HOURS=24
